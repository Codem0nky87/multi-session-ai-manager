# Generated Xcode project (regenerate with `xcodegen generate`)
# Generated by XcodeGen from app/MultiSessionAIManager/project.yml — never edit
# or commit these. `xcodegen generate` rewrites them, and the build pipeline runs
# it first (see docs/development.md and fastlane/Fastfile).
#
# Committing them is actively harmful, not just noise: fastlane stamps a build
# number into Info.plist and flips CODE_SIGN_STYLE to Manual in the pbxproj for
# distribution, so a committed copy would undo the Automatic signing project.yml
# specifies.
#
# Individual files, NOT the .xcodeproj directory: git cannot re-include a file
# whose parent directory is ignored, and Package.resolved lives inside it and is
# deliberately kept (it pins dependency versions).
app/MultiSessionAIManager/App/Info.plist
app/MultiSessionAIManager/MultiSessionAIManager.xcodeproj/project.pbxproj
app/MultiSessionAIManager/MultiSessionAIManager.xcodeproj/project.xcworkspace/contents.xcworkspacedata
app/MultiSessionAIManager/MultiSessionAIManager.xcodeproj/xcshareddata/

# Node sidecar dependencies
hub/sidecar/node_modules/

# git worktrees for isolated feature work
.worktrees/

# Xcode debug/deploy tool artifacts (embedded SwiftPM checkouts, logs)
.ddp2/

# Xcode DerivedData from scripted builds
ipad/MultiSessionAIManager/.ddp/
.ddp/
ipad/MultiSessionAIManager/.ddp-build/
.ddp-build/
ipad/MultiSessionAIManager/.ddp-test/
.ddp-test/

# Fastlane build artifacts + reports
ipad/MultiSessionAIManager/build/
app/MultiSessionAIManager/fastlane/report.xml
ipad/MultiSessionAIManager/fastlane/Preview.html
ipad/MultiSessionAIManager/fastlane/test_output/

# App Store Connect API keys — NEVER commit the .p8
**/*.p8

# Code-signing artifacts dropped by fastlane `cert` (downloaded certs)
**/*.cer
**/*.certSigningRequest
**/*.p12
